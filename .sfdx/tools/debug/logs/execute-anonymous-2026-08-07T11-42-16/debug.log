67.0 APEX_CODE,FINEST;APEX_PROFILING,INFO;VISUALFORCE,FINER
Execute Anonymous: Account acc = new Account(
Execute Anonymous:     Name = 'DEBUG Account',
Execute Anonymous:     BillingStreet = '1 Test', BillingCity = 'Test', BillingCountry = 'Germany'
Execute Anonymous: );
Execute Anonymous: insert acc;
Execute Anonymous: 
Execute Anonymous: Product2 prod = new Product2(
Execute Anonymous:     Name = 'DEBUG Car', IsActive = true,
Execute Anonymous:     Brand__c = 'Toyota', Model__c = 'Corolla',
Execute Anonymous:     VIN_Number__c = 'DEBUGVIN123456789', Condition__c = 'New', Mileage__c = 0
Execute Anonymous: );
Execute Anonymous: insert prod;
Execute Anonymous: 
Execute Anonymous: // Вместо Test.getStandardPricebookId() - берём реальный Standard Pricebook из org
Execute Anonymous: Id standardPbId = [SELECT Id FROM Pricebook2 WHERE IsStandard = true LIMIT 1].Id;
Execute Anonymous: 
Execute Anonymous: PricebookEntry pbe = new PricebookEntry(
Execute Anonymous:     Pricebook2Id = standardPbId,
Execute Anonymous:     Product2Id = prod.Id, UnitPrice = 20000, IsActive = true
Execute Anonymous: );
Execute Anonymous: insert pbe;
Execute Anonymous: 
Execute Anonymous: Opportunity opp1 = new Opportunity(
Execute Anonymous:     Name = 'DEBUG Opp1', AccountId = acc.Id,
Execute Anonymous:     StageName = 'Prospecting', CloseDate = Date.today().addDays(5)
Execute Anonymous: );
Execute Anonymous: insert opp1;
Execute Anonymous: 
Execute Anonymous: OpportunityLineItem li1 = new OpportunityLineItem(
Execute Anonymous:     OpportunityId = opp1.Id, PricebookEntryId = pbe.Id, UnitPrice = 20000
Execute Anonymous: );
Execute Anonymous: insert li1;
Execute Anonymous: 
Execute Anonymous: opp1.StageName = 'Contract Sent';
Execute Anonymous: update opp1;
Execute Anonymous: 
Execute Anonymous: Product2 checkProd = [SELECT Car_Status__c, Reserved_Sold_Opportunity__c FROM Product2 WHERE Id = :prod.Id];
Execute Anonymous: System.debug('=== ПРОВЕРКА 1: статус машины после Contract Sent ===');
Execute Anonymous: System.debug('Car_Status__c = ' + checkProd.Car_Status__c);
Execute Anonymous: System.debug('Reserved_Sold_Opportunity__c = ' + checkProd.Reserved_Sold_Opportunity__c);
Execute Anonymous: System.debug('opp1.Id (для сравнения) = ' + opp1.Id);
Execute Anonymous: 
Execute Anonymous: Opportunity opp2 = new Opportunity(
Execute Anonymous:     Name = 'DEBUG Opp2', AccountId = acc.Id,
Execute Anonymous:     StageName = 'Prospecting', CloseDate = Date.today().addDays(20)
Execute Anonymous: );
Execute Anonymous: insert opp2;
Execute Anonymous: 
Execute Anonymous: OpportunityLineItem li2 = new OpportunityLineItem(
Execute Anonymous:     OpportunityId = opp2.Id, PricebookEntryId = pbe.Id, UnitPrice = 20000
Execute Anonymous: );
Execute Anonymous: insert li2;
Execute Anonymous: 
Execute Anonymous: Opportunity checkOpp2 = [SELECT Has_Car_Conflict__c FROM Opportunity WHERE Id = :opp2.Id];
Execute Anonymous: System.debug('=== ПРОВЕРКА 2: конфликт на opp2 ===');
Execute Anonymous: System.debug('Has_Car_Conflict__c = ' + checkOpp2.Has_Car_Conflict__c);
Execute Anonymous: 
Execute Anonymous: // Чистим за собой тестовые данные
Execute Anonymous: delete li2;
Execute Anonymous: delete opp2;
Execute Anonymous: delete li1;
Execute Anonymous: delete opp1;
Execute Anonymous: delete pbe;
Execute Anonymous: delete prod;
Execute Anonymous: delete acc;
