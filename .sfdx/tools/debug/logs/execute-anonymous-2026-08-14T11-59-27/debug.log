67.0 APEX_CODE,FINEST;APEX_PROFILING,INFO;VISUALFORCE,FINER
Execute Anonymous: Account acc = new Account(
Execute Anonymous:     Name = 'DEBUG2 Account',
Execute Anonymous:     BillingStreet = '1 Test', BillingCity = 'Test', BillingCountry = 'Germany'
Execute Anonymous: );
Execute Anonymous: insert acc;
Execute Anonymous: 
Execute Anonymous: Product2 prod = new Product2(
Execute Anonymous:     Name = 'DEBUG2 Car', IsActive = true,
Execute Anonymous:     Brand__c = 'Toyota', Model__c = 'Corolla',
Execute Anonymous:     VIN_Number__c = 'DEBUG2VIN123456789', Condition__c = 'New', Mileage__c = 0
Execute Anonymous: );
Execute Anonymous: insert prod;
Execute Anonymous: 
Execute Anonymous: Id standardPbId = [SELECT Id FROM Pricebook2 WHERE IsStandard = true LIMIT 1].Id;
Execute Anonymous: 
Execute Anonymous: PricebookEntry pbe = new PricebookEntry(
Execute Anonymous:     Pricebook2Id = standardPbId,
Execute Anonymous:     Product2Id = prod.Id, UnitPrice = 20000, IsActive = true
Execute Anonymous: );
Execute Anonymous: insert pbe;
Execute Anonymous: 
Execute Anonymous: Opportunity opp = new Opportunity(
Execute Anonymous:     Name = 'DEBUG2 Opp', AccountId = acc.Id,
Execute Anonymous:     StageName = 'Prospecting', CloseDate = Date.today().addDays(5)
Execute Anonymous: );
Execute Anonymous: insert opp;
Execute Anonymous: 
Execute Anonymous: OpportunityLineItem li = new OpportunityLineItem(
Execute Anonymous:     OpportunityId = opp.Id, PricebookEntryId = pbe.Id, UnitPrice = 20000
Execute Anonymous: );
Execute Anonymous: insert li;
Execute Anonymous: 
Execute Anonymous: System.debug('=== ДО смены Stage ===');
Execute Anonymous: System.debug('Product Id = ' + prod.Id);
Execute Anonymous: 
Execute Anonymous: opp.StageName = 'Close Won';
Execute Anonymous: update opp;
Execute Anonymous: 
Execute Anonymous: Product2 checkProd = [SELECT Car_Status__c, RecordTypeId, Reserved_Sold_Opportunity__c FROM Product2 WHERE Id = :prod.Id];
Execute Anonymous: System.debug('=== ПОСЛЕ смены Stage на Close Won ===');
Execute Anonymous: System.debug('Car_Status__c = ' + checkProd.Car_Status__c);
Execute Anonymous: System.debug('RecordTypeId = ' + checkProd.RecordTypeId);
Execute Anonymous: System.debug('Reserved_Sold_Opportunity__c = ' + checkProd.Reserved_Sold_Opportunity__c);
Execute Anonymous: 
Execute Anonymous: PricebookEntry checkPbe = [SELECT IsActive FROM PricebookEntry WHERE Id = :pbe.Id];
Execute Anonymous: System.debug('PricebookEntry IsActive = ' + checkPbe.IsActive);
Execute Anonymous: 
Execute Anonymous: // Чистим
Execute Anonymous: delete li;
Execute Anonymous: delete opp;
Execute Anonymous: delete pbe;
Execute Anonymous: delete prod;
Execute Anonymous: delete acc;
