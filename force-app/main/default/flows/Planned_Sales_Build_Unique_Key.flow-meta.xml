<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>UniqueKeyFormula</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Year__c}) &amp; &quot;-&quot; &amp; TEXT({!$Record.Month__c}) &amp; &quot;-&quot; &amp; TEXT({!$Record.Car_Type__c})</expression>
    </formulas>
    <interviewLabel>Planned Sales - Build Unique Key {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Planned Sales - Build Unique Key 2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Unique_Key</name>
        <label>Set Unique Key</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Unique_Key_Stored__c</field>
            <value>
                <elementReference>UniqueKeyFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Unique_Key</targetReference>
        </connector>
        <object>Planned_Sales__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
